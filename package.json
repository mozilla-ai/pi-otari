{
  "name": "@mozilla-ai/pi-otari",
  "version": "0.1.0-rc.0",
  "description": "Route Pi model requests through Otari with automatic model discovery",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozilla-ai/pi-otari.git"
  },
  "homepage": "https://github.com/mozilla-ai/pi-otari#readme",
  "bugs": {
    "url": "https://github.com/mozilla-ai/pi-otari/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "assets",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "otari",
    "llm-gateway"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --experimental-strip-types test/live-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,json}": "biome check --write"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "^24.12.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
